{
  "name": "kosmos-ui",
  "version": "0.0.43",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm registry:build && next build",
    "dev": "pnpm registry:build && next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint && pnpm prose",
    "prose": "node scripts/prose.mts",
    "registry:build": "node --env-file-if-exists=.env.local scripts/registry-build.mts",
    "registry:check": "node --env-file-if-exists=.env.local scripts/registry-check.mts",
    "registry:smoke": "node --env-file-if-exists=.env.local scripts/registry-smoke.mts",
    "docs:check": "node --env-file-if-exists=.env.local scripts/docs-check.mts",
    "links:check": "node scripts/links-check.mts",
    "screenshots": "node scripts/screenshots.mts",
    "thumbnails": "node scripts/screenshots.mts --thumbnails",
    "test": "node --test 'lib/**/*.test.mts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vvago/vale": "^3.25.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.64.0",
    "postcss": "^8.5.28",
    "shadcn": "4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vvago/vale",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
